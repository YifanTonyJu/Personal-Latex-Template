}

% ========== PROOF ENVIRONMENT ==========
% Three proof environments with different QED symbols
% Usage: 
%   \begin{proof} ... \end{proof}           → ends with ∎ (black square, for Theorem/Proposition)
%   \begin{prooflemma} ... \end{prooflemma} → ends with □ (hollow square, for Lemma)
%   \begin{proofclaim} ... \end{proofclaim} → ends with □ (hollow square, for Claim)

\newenvironment{proof}{%
    \vspace{0.5em}\par\noindent\textbf{Proof.}\setlength{\parskip}{0em}%
}{%
    \par\noindent\hfill$\blacksquare$\par\vspace{0.3em}
}

\newenvironment{prooflemma}{%
    \vspace{0.5em}\par\noindent\textbf{Proof.}\setlength{\parskip}{0em}%
}{%
    \par\noindent\hfill$\square$\par\vspace{0.3em}
}

\newenvironment{proofclaim}{%
    \vspace{0.5em}\par\noindent\textbf{Proof.}\setlength{\parskip}{0em}%
}{%
    \par\noindent\hfill$\square$\par\vspace{0.3em}
}

% ========== SOLUTION ENVIRONMENT ==========
% Lightweight solution/answer environment for problem solving
% Usage:
%   \begin{solution} ... \end{solution}   → numbered solution
%   \begin{solution*} ... \end{solution*} → unnumbered solution

\newenvironment{solution}{%
    \stepcounter{solutioncounter}\vspace{0.8em}\par\noindent\textbf{Solution \arabic{solutioncounter}.}\setlength{\parskip}{0em}%
}{
    \par\vspace{0.2em}
}

\newenvironment{solution*}{%
    \vspace{0.8em}\par\noindent\textbf{Solution.}\setlength{\parskip}{0em}%
}{
    \par\vspace{0.2em}
}

% ========== PROBLEM ENVIRONMENT ==========
% Problem environment for stating problems/exercises
% Usage:
%   \begin{problem} ... \end{problem}   → numbered problem
%   \begin{problem*} ... \end{problem*} → unnumbered problem

\newenvironment{problem}{%
    \stepcounter{problemcounter}\vspace{0.8em}\par\noindent\textbf{Problem \arabic{problemcounter}.}\setlength{\parskip}{0em}%
}{
    \par\vspace{0.2em}
}

\newenvironment{problem*}{%
    \vspace{0.8em}\par\noindent\textbf{Problem.}\setlength{\parskip}{0em}%
}{
    \par\vspace{0.2em}
}

