% ========== COVER PAGE ==========
\newcommand{\makecustomcover}{%
    \begin{titlepage}
        \thispagestyle{empty}  % Hide page number on cover page
        \begin{center}
            \vspace{1.5cm}

            \ifstrempty{\CoverSeasonYear}{}{\nonemptyorplaceholder{\CoverSeasonYear}\par}

            \vspace{0.6cm}

            \hrulefill

            \vspace{0.3cm}

            \ifstrempty{\CoverTitle}{}{\huge\textbf{{\TitleFont\nonemptyorplaceholder{\CoverTitle}}}\par}

            \vspace{0.7cm}

            \ifstrempty{\CoverCourse}{}{\LARGE\textbf{{\TitleFont\nonemptyorplaceholder{\CoverCourse}}}\par}

            \vspace{0.2cm}

            \hrulefill

            \vspace{1.8cm}

            \ifstrempty{\CoverSchoolLogoFile}{}{%
                \IfFileExists{\CoverSchoolLogoFile}{%
                    \includegraphics[trim={0 0 0.1cm 0},clip,scale=\CoverSchoolLogoScale]{\CoverSchoolLogoFile}%
                }{}
            }

            \vspace{2cm}
        \end{center}

        \vfill

        % Fields - center each label-value pair as a single line
        \begin{center}
            \ifnum\CoverFieldsNumber>0
                \begin{tabular}{c}
                    \ifnum\CoverFieldsNumber>0 \textbf{\CoverFieldOneLabel:}\ \CoverFieldOneValue \\ [0.4cm] \fi
                    \ifnum\CoverFieldsNumber>1 \textbf{\CoverFieldTwoLabel:}\ \CoverFieldTwoValue \\ [0.4cm] \fi
                    \ifnum\CoverFieldsNumber>2 \textbf{\CoverFieldThreeLabel:}\ \CoverFieldThreeValue \\ [0.4cm] \fi
                    \ifnum\CoverFieldsNumber>3 \textbf{\CoverFieldFourLabel:}\ \CoverFieldFourValue \\ [0.4cm] \fi
                    \ifnum\CoverFieldsNumber>4 \textbf{\CoverFieldFiveLabel:}\ \CoverFieldFiveValue \fi
                \end{tabular}
            \fi
        \end{center}

        \vspace{1.5cm}

        % Signature
        \ifstrempty{\CoverSignatureFile}{}{%
            \IfFileExists{\CoverSignatureFile}{%
                \hfill \includegraphics[scale=\CoverSignatureScale]{\CoverSignatureFile} \hspace{0.3cm}%
            }{}
        }
    \end{titlepage}
}

% ========== FRONTMATTER ENTRYPOINT ==========
% Order:
% - CoverOnly: Cover page -> Table of Contents -> content on new page
% - TitleOnly: Title page -> content continues on same page (no TOC)
\newcommand{\makefrontmatter}{%
    \ifCoverOnly
        \pagenumbering{gobble}  % Suppress page numbering for cover page
        \makecustomcover
        \newpage
        % Table of contents for cover only mode
        \pagenumbering{roman}  % Use lowercase roman numerals for frontmatter
        \pagestyle{tocpage}    % Use pre-defined tocpage style
        \tableofcontents
        \newpage
        \pagenumbering{arabic}  % Switch to arabic numerals for main content
        \setcounter{page}{1}     % Reset page number to 1
        \pagestyle{maincontent} % Switch to pre-defined main content style
    \fi
    \ifTitleOnly
        \pagenumbering{gobble}  % Suppress page numbering for title page
        \makepersonaltitle
        \pagenumbering{arabic}  % Switch to arabic numerals for main content
        \setcounter{page}{1}     % Reset page number to 1
        \pagestyle{maincontent} % Switch to pre-defined main content style
    \fi
}