% ========== CODE BOX ENVIRONMENT ==========
% Supports multiple programming languages
% Usage: \begin{codebox}[language]...code...\end{codebox}
% Supported languages: python, java, c, sql, html, bash, etc.

% Define codebox using lstnewenvironment with optional language parameter
\lstnewenvironment{codebox}[1][]{%
    \lstset{
        language=#1,
        frame=shadowbox,
        rulesepcolor=\color{gray},
        backgroundcolor=\color{white},
        captionpos=b,
        numbers=left,
        stepnumber=1,
        firstnumber=0,
        numberfirstline=true,
        aboveskip=3mm,
        belowskip=3mm,
        showstringspaces=false,
        keepspaces=true,
        columns=fullflexible,
        basicstyle={\small\ttfamily},
        numberstyle=\tiny\color{gray},
        keywordstyle=\color{black},
        commentstyle=\color{black},
        stringstyle=\color{black},
        breaklines=true,
        breakatwhitespace=true,
        tabsize=3
    }%
}{%
}

% Code input command - wrapper for \lstinputlisting
% Usage: \inputcode{language}{filepath} or \inputcode{}{filepath} for plain text
\newcommand{\inputcode}[2]{%
    \lstinputlisting[
        language=#1,
        frame=shadowbox,
        rulesepcolor=\color{gray},
        numbers=left,
        stepnumber=1,
        firstnumber=0,
        numberfirstline=true,
        aboveskip=3mm,
        belowskip=3mm,
        showstringspaces=false,
        columns=flexible,
        basicstyle={\small\ttfamily},
        numberstyle=\tiny\color{gray},
        keywordstyle=\color{black},
        commentstyle=\color{black},
        stringstyle=\color{black},
        breaklines=true,
        breakatwhitespace=true,
        tabsize=3
    ]{#2}%
}

% ========== MATHEMATICAL STATEMENTS ENVIRONMENTS ==========
% Multiple environments for different types of mathematical statements
% Usage: \begin{theorem}...\end{theorem}, \begin{lemma}...\end{lemma}, etc.
% Each statement type comes with its own label
% Can be numbered like equations using * for unnumbered or default for numbered

% Counters for mathematical statements
\newcounter{theoremcounter}
\newcounter{lemmacounter}
\newcounter{claimcounter}
\newcounter{corollarycounter}
\newcounter{propositioncounter}
\newcounter{definitioncounter}
\newcounter{solutioncounter}
\newcounter{problemcounter}

\newenvironment{theorem}{%
    \stepcounter{theoremcounter}\vspace{0.8em}\par\noindent\textbf{Theorem \arabic{theoremcounter}.}\itshape\setlength{\parskip}{0em}%
}{%
    \par\vspace{0.2em}
}

\newenvironment{theorem*}{%
    \vspace{0.8em}\par\noindent\textbf{Theorem.}\itshape\setlength{\parskip}{0em}%
}{%
    \par\vspace{0.2em}
}

\newenvironment{lemma}{%
    \stepcounter{lemmacounter}\vspace{0.8em}\par\noindent\textbf{Lemma \arabic{lemmacounter}.}\itshape\setlength{\parskip}{0em}%
}{%
    \par\vspace{0.2em}
}

\newenvironment{lemma*}{%
    \vspace{0.8em}\par\noindent\textbf{Lemma.}\itshape\setlength{\parskip}{0em}%
}{%
    \par\vspace{0.2em}
}

\newenvironment{claim}{%
    \stepcounter{claimcounter}\vspace{0.8em}\par\noindent\textbf{Claim \arabic{claimcounter}.}\itshape\setlength{\parskip}{0em}%
}{%
    \par\vspace{0.2em}
}

\newenvironment{claim*}{%
    \vspace{0.8em}\par\noindent\textbf{Claim.}\itshape\setlength{\parskip}{0em}%
}{%
    \par\vspace{0.2em}
}

\newenvironment{corollary}{%
    \stepcounter{corollarycounter}\vspace{0.8em}\par\noindent\textbf{Corollary \arabic{corollarycounter}.}\itshape\setlength{\parskip}{0em}%
}{%
    \par\vspace{0.2em}
}

\newenvironment{corollary*}{%
    \vspace{0.8em}\par\noindent\textbf{Corollary.}\itshape\setlength{\parskip}{0em}%
}{%
    \par\vspace{0.2em}
}

\newenvironment{proposition}{%
    \stepcounter{propositioncounter}\vspace{0.8em}\par\noindent\textbf{Proposition \arabic{propositioncounter}.}\itshape\setlength{\parskip}{0em}%
}{%
    \par\vspace{0.2em}
}

\newenvironment{proposition*}{%
    \vspace{0.8em}\par\noindent\textbf{Proposition.}\itshape\setlength{\parskip}{0em}%
}{%
    \par\vspace{0.2em}
}

\newenvironment{definition}{%
    \stepcounter{definitioncounter}\vspace{0.8em}\par\noindent\textbf{Definition \arabic{definitioncounter}.}\itshape\setlength{\parskip}{0em}%
}{%
