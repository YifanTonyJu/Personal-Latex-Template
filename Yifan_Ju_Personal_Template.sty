\newcommand{\makepersonaltitle}{%
    \ifTitleOnly
        % Define a custom pagestyle for titleonly first page
        \fancypagestyle{titlefirst}{%
            \fancyhf{}
            \cfoot{\textit{\thepage}}
            \renewcommand{\headrulewidth}{0pt}
        }
        \thispagestyle{titlefirst}
    \else
        \thispagestyle{empty}  % Hide header and footer on title page
    \fi
    \noindent
    \begingroup
    \centering

    \vspace{0.5cm}
    \setlength{\personalTitleGap}{0pt}

    % Document type (optional)
    \ifdefempty{\PersonalDocType}{}{\small\textsc{\PersonalDocType}\par\setlength{\personalTitleGap}{0.2cm}}

    % Main title (optional)
    \ifdefempty{\PersonalDocTitle}{}{%
        \vspace{\personalTitleGap}
        \LARGE\textbf{{\TitleFont\PersonalDocTitle}}\par
        \setlength{\personalTitleGap}{0.2cm}%
    }

    % Subtitle (optional)
    \ifdefempty{\PersonalDocSubtitle}{}{%
        \vspace{\personalTitleGap}
        {\TitleFont\large\textit{\PersonalDocSubtitle}}\par
        \setlength{\personalTitleGap}{0.2cm}%
    }

    % Author and date
    \ifdefempty{\PersonalDocAuthor}{}{%
        \vspace{\personalTitleGap}
        \normalsize\textbf{\PersonalDocAuthor}\par
        \setlength{\personalTitleGap}{0.2cm}%
    }
    \ifdefempty{\PersonalDocDate}{}{%
        \vspace{\personalTitleGap}
        \normalsize\PersonalDocDate\par
    }

    % Conditional spacing: more space if fields exist, less if not
    \ifnum\TitleFieldsNumber>0
        \vspace{0.2cm}
        % Center each label-value pair as a single line
        \begin{tabular}{c}
            \ifnum\TitleFieldsNumber>0 \textbf{\TitleFieldOneLabel:}\ \TitleFieldOneValue \\ [0.3cm] \fi
            \ifnum\TitleFieldsNumber>1 \textbf{\TitleFieldTwoLabel:}\ \TitleFieldTwoValue \\ [0.3cm] \fi
            \ifnum\TitleFieldsNumber>2 \textbf{\TitleFieldThreeLabel:}\ \TitleFieldThreeValue \\ [0.3cm] \fi
            \ifnum\TitleFieldsNumber>3 \textbf{\TitleFieldFourLabel:}\ \TitleFieldFourValue \\ [0.3cm] \fi
            \ifnum\TitleFieldsNumber>4 \textbf{\TitleFieldFiveLabel:}\ \TitleFieldFiveValue \fi
        \end{tabular}\par
        \vspace{0.2cm}
    \else
        \vspace{0.2cm}
    \fi

    % Title page signature (right aligned, between fields and bottom line)
    % Only show signature in title-only mode
    \ifTitleOnly
        \ifdefempty{\TitleSignatureFile}{}{%
            \IfFileExists{\TitleSignatureFile}{%
                \hfill \includegraphics[scale=\TitleSignatureScale]{\TitleSignatureFile} \hspace{0.3cm} \par
            }{}%
        }
    \fi

    \vspace{0.1cm}
    \hrulefill
    \vspace{0.8cm}

    \endgroup
}

